# Salin file ini menjadi .env jika perlu mengubah konfigurasi.
# Jangan mengisi credential asli ke file ini dan jangan commit file .env.

NODE_ENV=development
PORT=3000
SITE_NAME=Mini CMS

# Opsional. Path absolut atau relatif terhadap root project.
# Nilai khusus ":memory:" dipakai oleh pengujian otomatis.
# Default: server/data/mini-cms.db
# DATABASE_PATH=

# Sesi admin.
SESSION_TTL_HOURS=168
# Atur true hanya jika aplikasi diakses melalui HTTPS.
COOKIE_SECURE=false

# Percayai header X-Forwarded-* dari reverse proxy tepercaya.
# Aktifkan hanya jika API tidak dapat diakses langsung dari publik.
# TRUST_PROXY=false

# Kredensial untuk `npm run seed:admin`.
# Isi hanya pada file .env lokal. Jangan simpan nilai asli di file ini.
# Password minimal 12 karakter.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
